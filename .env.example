# ─────────────────────────────────────────────────────────────────
# All variables below are OPTIONAL.
# The skills work in draft-only mode with nothing set.
# Add a PUBLORA_API_KEY to enable auto-posting on approval.
# ─────────────────────────────────────────────────────────────────

# Publora API key — sign up free at https://app.publora.com/signup
# 15 LinkedIn + Bluesky posts/month on free tier
PUBLORA_API_KEY=sk_your_key_here

# LinkedIn platform connection ID (format: linkedin-ABC123)
# Find this in the Publora dashboard: Channels → your LinkedIn account
LINKEDIN_PLATFORM_ID=linkedin-your_id_here

# ─────────────────────────────────────────────────────────────────
# Apify token (optional) - lets the skills fetch LinkedIn post bodies,
# comment threads, and a user's recent comments without cookies. Free
# tier ships with $5/month of credit, which goes a long way at $1-$5
# per 1,000 results.
#
# Sign up: https://console.apify.com/sign-up
# Token:   https://console.apify.com/settings/integrations
#
# Without a token, the skills fall back to asking you to paste post
# text or comment URLs by hand.
# ─────────────────────────────────────────────────────────────────
APIFY_TOKEN=apify_api_your_token_here

# ─────────────────────────────────────────────────────────────────
# Pixfaro token (optional) - lets the skills generate illustrations for
# posts (feed images, carousel slides, quote-cards) and attach them on
# publish. Returns a hosted URL that flows straight into Publora media.
# Pixel-exact text/logo overlay keeps every asset on-brand.
#
# Sign up: https://api.pixfaro.com/signup?ref=linkedin-skills  (key format: pf_live_...)
# This file must sit at the root of the linkedin-skills folder; verify with
# `python3 scripts/check_config.py` (calls GET /v1/key).
#
# Without a token, the skills draft the image prompt and ask you to
# generate it yourself and paste the URL.
# ─────────────────────────────────────────────────────────────────
PIXFARO_TOKEN=pf_live_your_token_here

# ─────────────────────────────────────────────────────────────────
# Dashboard event logging (optional) - if you run the observability
# dashboard in dashboard/, set both so skill runs show up in its
# Skills and Activity screens. Fails silently with either unset.
# ─────────────────────────────────────────────────────────────────
DASHBOARD_EVENTS_URL=https://dash.example.com
EVENTS_INGEST_SECRET=same_value_as_dashboard_EVENTS_INGEST_SECRET

# ─────────────────────────────────────────────────────────────────
# Advanced (Tier 2): if you've built your own poster with Claude Code or Codex,
# set this to the command/module path the skills should invoke on approval.
# Leave unset unless you actually have a custom poster working.
# ─────────────────────────────────────────────────────────────────
# LINKEDIN_SKILLS_CUSTOM_POSTER=python /path/to/my-poster.py

# ─────────────────────────────────────────────────────────────────
# GitHub token (optional) - lets scripts/mine_evidence.py read your
# PRIVATE repositories so drafts can cite real, dated build evidence.
#
# Use a FINE-GRAINED personal access token, not a classic one:
#   https://github.com/settings/personal-access-tokens/new
#   Repository access: "Only select repositories" - pick the ones to mine
#   Permissions: Contents = Read-only, Metadata = Read-only. Nothing else.
#   Expiration: 90 days. Rotate it; do not use "no expiration".
#
# Read-only by construction: this token cannot push, cannot delete, and
# cannot touch a repo you did not select. Never commit it.
#
# Without a token, mine_evidence.py reads your local clones and your
# public repos only.
# ─────────────────────────────────────────────────────────────────
GITHUB_TOKEN=github_pat_your_token_here

# Daily pipeline (automation/run_daily.py): true publishes unattended,
# false queues each draft in drafts/ for you to approve.
AUTOPUBLISH=false

# ─────────────────────────────────────────────────────────────────
# Daily pipeline tuning (automation/run_daily.py). All optional.
# ─────────────────────────────────────────────────────────────────
# Refuse to auto-publish at/after this local hour (a late run usually means
# the laptop was asleep at 07:00 and the task fired on wake).
PUBLISH_BEFORE_HOUR=11

# Which image backend to use when AUTOPUBLISH is on: "card" renders a
# branded quote-card locally and hosts it via git push (free); "none"
# disables images; anything else uses Pixfaro illustrate (PIXFARO_TOKEN).
IMAGE_BACKEND=card

# Only used when IMAGE_BACKEND is not "card"/"none" (Pixfaro illustrate).
IMAGE_MODEL=gpt-5-image
IMAGE_RESOLUTION=2K
